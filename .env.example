# Gemini (Google AI Studio). Without it, replies come from the engine's own sentences.
GEMINI_API_KEY=
# Optional: GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Official station data. Either can be left blank; the forecast is then shown unanchored.
# data.gov.in key for CPCB's "Real time Air Quality Index from various locations".
DATA_GOV_IN_API_KEY=
# WAQI token from https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Accounts: set SESSION_SECRET (32+ characters, e.g. `openssl rand -base64 48`) to turn on
# email-and-password sign-in. Blank runs without sign-in, one shared household (development only).
SESSION_SECRET=
# Where records live: memory (development) or firestore (production, needs Google credentials).
STORE=memory

# Web Push for background alerts: `npx web-push generate-vapid-keys`. All three or none.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cloud Scheduler identity for the background alert check. Set both or neither.
# SCHEDULER_AUDIENCE=https://<your-service>.run.app
# SCHEDULER_SERVICE_ACCOUNT=vayu-scheduler@<project>.iam.gserviceaccount.com

# Optional: AIR_DATA_MODE=fixture (offline demo; refused in production)
PORT=8080
# Optional: AI_REQUESTS_PER_MINUTE=10, AUTH_REQUESTS_PER_MINUTE=10,
# DATA_REQUESTS_PER_MINUTE=60 (per client address)
