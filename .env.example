# Gemini (Google AI Studio). Without it, replies come from the engine's own sentences.
GEMINI_API_KEY=
# Optional: GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Official station data. Either can be left blank; the forecast is then shown unanchored.
# data.gov.in key for CPCB's "Real time Air Quality Index from various locations".
DATA_GOV_IN_API_KEY=
# WAQI token from https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Firebase (Google sign-in, Firestore, Cloud Messaging). Leave FIREBASE_PROJECT_ID blank
# to run without sign-in (development only). The web config values are public identifiers.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Optional: FIREBASE_AUTH_DOMAIN (defaults to <project>.firebaseapp.com)
# Web Push certificate public key (Project settings > Cloud Messaging). Without it, alerts are off.
FIREBASE_VAPID_KEY=

# Cloud Scheduler identity for the background alert check. Set both or neither.
# SCHEDULER_AUDIENCE=https://<your-service>.run.app
# SCHEDULER_SERVICE_ACCOUNT=vayu-scheduler@<project>.iam.gserviceaccount.com

# Optional: AIR_DATA_MODE=fixture (offline demo; refused in production)
PORT=8080
# Optional: AI_REQUESTS_PER_MINUTE=10 (per client address)
