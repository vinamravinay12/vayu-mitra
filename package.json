{
  "name": "vayu-mitra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GenAI clean-air assistant that helps families and communities get through winter smog",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspaces --if-present",
    "profile": "tsc -b packages/server && node --expose-gc scripts/profile-engine.mjs && node scripts/profile-server.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "dev:server": "npm run dev -w @vayu/server",
    "dev:client": "npm run dev -w @vayu/client",
    "start": "npm run start -w @vayu/server",
    "dev": "npm run dev:server & npm run dev:client",
    "e2e": "playwright test",
    "start:e2e": "npm run build && cross-env AIR_DATA_MODE=fixture AI_REQUESTS_PER_MINUTE=1000 STATIC_DIR=packages/client/dist node packages/server/dist/index.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
